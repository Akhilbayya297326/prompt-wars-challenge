{
  "name": "krishi-chakra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings src api scripts server shared test",
    "check": "npm run lint && npm test && npm run build",
    "build": "vite build && node scripts/cache-assets.js",
    "start": "node --env-file-if-exists=.env server/start.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-test.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "axios": "^1.13.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^1.80.0",
    "mongodb": "^6.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "oxlint": "^1.95.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "vite": "^7.2.2"
  }
}
